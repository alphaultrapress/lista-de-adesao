# =====================================================
# Supabase
# =====================================================
# Chaves publicas. RLS protege os dados.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Service role key (NUNCA prefixar com NEXT_PUBLIC_).
# Pega em Supabase -> Settings -> API -> service_role secret.
# Usada pelo /api/notify-meta para somar convites e marcar meta_notified_at.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# =====================================================
# App
# =====================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =====================================================
# CPF API (server-side)
# =====================================================
CPF_API_TOKEN=coloque-seu-token-aqui
CPF_API_URL=https://apicpf.com/api/consulta

# =====================================================
# Resend (envio de email quando atinge 30 convites)
# =====================================================
# Pega em https://resend.com -> API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Opcional. Default: "Alpha Convites <onboarding@resend.dev>" (sandbox).
# Depois de verificar o dominio em resend.com, troca por algo como:
# "Alpha Convites <noreply@alphaeditora.com.br>"
RESEND_FROM_EMAIL=Alpha Convites <onboarding@resend.dev>

# =====================================================
# Bitrix24 (cria Lead quando atinge 30 convites)
# =====================================================
# URL completa do webhook de entrada. Formato:
# https://SEU-DOMINIO.bitrix24.com.br/rest/USER_ID/CHAVE/
BITRIX_WEBHOOK_URL=
# Opcional. ID numerico do usuario do Bitrix que vai receber o Lead.
# Se vazio, usa o usuario dono do webhook.
BITRIX_ASSIGNED_BY_ID=
